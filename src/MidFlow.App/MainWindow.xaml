<Window x:Class="MidFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MidFlow.App"
        Title="MidFlow"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">
  <Grid IsHitTestVisible="False">
    <local:TrailSurface x:Name="TrailSurface" />
    <Canvas x:Name="FeedbackCanvas" ClipToBounds="True">
      <Border x:Name="ResultFeedback" Visibility="Collapsed" Background="#E6222630" CornerRadius="6" Padding="10,6">
        <TextBlock x:Name="ResultFeedbackText" Foreground="White" FontSize="13"/>
      </Border>
    </Canvas>
  </Grid>
</Window>
