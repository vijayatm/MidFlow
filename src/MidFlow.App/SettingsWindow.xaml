<Window x:Class="MidFlow.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MidFlow Settings" Height="920" Width="760"
        ResizeMode="CanResize" MinHeight="760" MinWidth="650"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="MidFlow Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <StackPanel Grid.Row="1">
      <CheckBox x:Name="GesturesCheckBox" Content="Enable middle-button gestures" Margin="0,0,0,12"/>
      <CheckBox x:Name="TrailCheckBox" Content="Show cursor trail and direction feedback"/>
    </StackPanel>
    <GroupBox Grid.Row="2" Header="Gestures &amp; shortcuts" Margin="0,12,0,0" Padding="12">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Content="Browse…" Padding="10,4" Margin="0,0,6,0" Click="BrowseApplication_Click"/>
            <Button Content="Add app" Padding="10,4" Click="AddApplication_Click"/>
          </StackPanel>
          <TextBox x:Name="ApplicationTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center"
                   ToolTip="Enter a process name or browse to its executable"/>
        </DockPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,10,0">
            <TextBlock Text="PROFILES" FontWeight="SemiBold" Foreground="#666" Margin="4,0,4,5"/>
            <TextBox x:Name="ProfileSearchBox" Margin="0,0,0,6" ToolTip="Filter application profiles"
                     TextChanged="ProfileSearch_TextChanged"/>
            <ListBox x:Name="ProfileListBox" SelectionChanged="ProfileListBox_SelectionChanged"/>
          </StackPanel>
          <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Padding="12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel>
                <Button x:Name="RemoveApplicationButton" DockPanel.Dock="Right" Content="Remove app"
                        Padding="8,3" Click="RemoveApplication_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="SelectedProfileTitle" Text="Global defaults" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel Grid.Row="1" Margin="0,8,0,8">
                <CheckBox x:Name="ApplicationEnabledCheckBox" Content="Enable gestures for this app"
                          VerticalAlignment="Center" Checked="ApplicationEnabled_Changed"
                          Unchecked="ApplicationEnabled_Changed" Visibility="Collapsed"/>
                <TextBlock x:Name="ProfileDescription" Text="These defaults apply to applications without an override."
                           Foreground="#666" TextWrapping="Wrap"/>
              </DockPanel>
              <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="GestureRowsPanel"/>
              </ScrollViewer>
              <Button x:Name="AddCustomGestureButton" Grid.Row="3" Content="Add custom shape…"
                      HorizontalAlignment="Left" Padding="10,5" Margin="0,10,0,0" Click="AddCustomGesture_Click"/>
              <TextBlock Grid.Row="4" Text="Custom shapes are matched before directional gestures. Similar active shapes in one profile are rejected."
                         Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </GroupBox>
    <GroupBox Grid.Row="3" Header="Gesture sensitivity" Margin="0,12,0,0" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Minimum directional movement (px)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="MinimumHorizontalTextBox" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Row="1" Text="Maximum cross-axis drift (px)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="MaximumVerticalTextBox" Grid.Row="1" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Row="2" Text="Maximum gesture duration (ms)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="MaximumDurationTextBox" Grid.Row="2" Grid.Column="1" Margin="4"/>
        <TextBlock Grid.Row="3" Text="Click jitter threshold (px)" VerticalAlignment="Center" Margin="0,4"/>
        <TextBox x:Name="ClickThresholdTextBox" Grid.Row="3" Grid.Column="1" Margin="4"/>
      </Grid>
    </GroupBox>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancel" Width="82" Margin="0,0,8,0" IsCancel="True"/>
      <Button Content="Save" Width="82" IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
