<Window x:Class="MidFlow.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MidFlow Settings" Height="790" Width="900"
        ResizeMode="CanResize" MinHeight="650" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Closing="SettingsWindow_Closing">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12">
      <TextBlock Text="MidFlow Settings" FontSize="21" FontWeight="SemiBold"/>
      <TextBlock x:Name="UnsavedChangesText" DockPanel.Dock="Right" Text="Unsaved changes" Foreground="#8A5A00"
                 VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="Unsaved changes"/>
    </DockPanel>
    <TabControl Grid.Row="1" AutomationProperties.Name="Settings sections">
      <TabItem Header="General" AutomationProperties.Name="General settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <GroupBox Header="Gesture behavior" Padding="12" Margin="0,0,0,12">
              <StackPanel>
                <CheckBox x:Name="GesturesCheckBox" Content="Enable middle-button gestures" Margin="0,0,0,6"
                          AutomationProperties.Name="Enable middle-button gestures" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                <TextBlock Text="When enabled, a middle-button drag performs its configured gesture. A stationary middle click is replayed."
                           Foreground="#666" TextWrapping="Wrap" Margin="22,0,0,0"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Gesture sensitivity" Padding="12">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,3,8,6"><TextBlock Text="Minimum directional movement (px)"/><TextBlock Text="How far the pointer must travel to count as a gesture." Foreground="#666" FontSize="11"/></StackPanel>
                <TextBox x:Name="MinimumHorizontalTextBox" Grid.Column="1" Margin="4" VerticalContentAlignment="Center" AutomationProperties.Name="Minimum directional movement in pixels" TextChanged="Sensitivity_TextChanged" LostFocus="Sensitivity_LostFocus"/>
                <TextBlock x:Name="MinimumHorizontalError" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#B00020" FontSize="11" Visibility="Collapsed"/>
                <StackPanel Grid.Row="2" Margin="0,3,8,6"><TextBlock Text="Maximum cross-axis drift (px)"/><TextBlock Text="How much sideways or vertical wobble a gesture can tolerate." Foreground="#666" FontSize="11"/></StackPanel>
                <TextBox x:Name="MaximumVerticalTextBox" Grid.Row="2" Grid.Column="1" Margin="4" VerticalContentAlignment="Center" AutomationProperties.Name="Maximum cross-axis drift in pixels" TextChanged="Sensitivity_TextChanged" LostFocus="Sensitivity_LostFocus"/>
                <TextBlock x:Name="MaximumVerticalError" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#B00020" FontSize="11" Visibility="Collapsed"/>
                <StackPanel Grid.Row="4" Margin="0,3,8,6"><TextBlock Text="Maximum gesture duration (ms)"/><TextBlock Text="Longer drags are ignored to avoid accidental actions." Foreground="#666" FontSize="11"/></StackPanel>
                <TextBox x:Name="MaximumDurationTextBox" Grid.Row="4" Grid.Column="1" Margin="4" VerticalContentAlignment="Center" AutomationProperties.Name="Maximum gesture duration in milliseconds" TextChanged="Sensitivity_TextChanged" LostFocus="Sensitivity_LostFocus"/>
                <TextBlock x:Name="MaximumDurationError" Grid.Row="5" Grid.ColumnSpan="2" Foreground="#B00020" FontSize="11" Visibility="Collapsed"/>
                <StackPanel Grid.Row="6" Margin="0,3,8,6"><TextBlock Text="Click jitter threshold (px)"/><TextBlock Text="Movement below this distance is treated as a stationary middle click." Foreground="#666" FontSize="11"/></StackPanel>
                <TextBox x:Name="ClickThresholdTextBox" Grid.Row="6" Grid.Column="1" Margin="4" VerticalContentAlignment="Center" AutomationProperties.Name="Click jitter threshold in pixels" TextChanged="Sensitivity_TextChanged" LostFocus="Sensitivity_LostFocus"/>
                <TextBlock x:Name="ClickThresholdError" Grid.Row="7" Grid.ColumnSpan="2" Foreground="#B00020" FontSize="11" Visibility="Collapsed"/>
                <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="Preset" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="SensitivityPresetBox" Width="170" SelectedIndex="1" SelectionChanged="SensitivityPreset_SelectionChanged" AutomationProperties.Name="Gesture sensitivity preset">
                    <ComboBoxItem Content="Relaxed"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Precise"/><ComboBoxItem Content="Custom" IsEnabled="False"/>
                  </ComboBox>
                  <TextBlock Text="Relaxed tolerates more movement; Precise requires a clearer, faster drag." Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
              </Grid>
            </GroupBox>
            <TextBlock Text="Defaults: 70 px movement, 120 px drift, 1000 ms duration, and 5 px click jitter." Foreground="#666" Margin="4,10,4,0" TextWrapping="Wrap"/>
            <Button Content="Restore recommended defaults…" HorizontalAlignment="Left" Padding="10,5" Margin="0,14,0,0" Click="RestoreDefaults_Click"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="ApplicationsTab" Header="Applications" AutomationProperties.Name="Application gesture profiles">
        <Grid Margin="14">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Browse…" Padding="10,4" Margin="0,0,6,0" Click="BrowseApplication_Click" AutomationProperties.Name="Browse for an application executable"/>
              <Button Content="Add app" Padding="10,4" Click="AddApplication_Click"/>
              <Button x:Name="CopyApplicationButton" Content="Copy selected" Padding="10,4" Margin="6,0,0,0" Click="CopyApplication_Click" IsEnabled="False"
                      ToolTip="Copy the selected app profile to the process name in the field"/>
            </StackPanel>
            <StackPanel>
              <TextBox x:Name="ApplicationTextBox" Margin="0,0,8,0" VerticalContentAlignment="Center"
                       ToolTip="Enter a process name or browse to its executable" AutomationProperties.Name="Application process name"
                       PreviewKeyDown="ApplicationTextBox_PreviewKeyDown" TextChanged="ApplicationTextBox_TextChanged"/>
              <TextBlock x:Name="ApplicationResolutionText" Text="Enter a target process name. Add app creates an inherited profile; Copy selected copies the current profile. Matching uses process name only." Foreground="#666"
                         FontSize="11" TextWrapping="Wrap" Margin="2,3,4,0"/>
            </StackPanel>
          </DockPanel>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="PROFILES" FontWeight="SemiBold" Foreground="#666" Margin="4,0,4,5"/>
            <DockPanel Grid.Row="1" Margin="0,0,10,0">
              <StackPanel>
                <TextBox x:Name="ProfileSearchBox" Margin="0,0,0,6" ToolTip="Filter application profiles"
                         AutomationProperties.Name="Search application profiles" TextChanged="ProfileSearch_TextChanged"/>
                <ComboBox x:Name="ProfileSortBox" Margin="0,0,0,6" SelectedIndex="0"
                          AutomationProperties.Name="Sort application profiles" SelectionChanged="ProfileSort_SelectionChanged">
                  <ComboBoxItem Content="Name (A to Z)"/><ComboBoxItem Content="Enabled first"/>
                </ComboBox>
              </StackPanel>
              <ListBox x:Name="ProfileListBox" DockPanel.Dock="Bottom" SelectionChanged="ProfileListBox_SelectionChanged"
                       AutomationProperties.Name="Global and application profiles"/>
            </DockPanel>
            <Border Grid.Column="1" Grid.RowSpan="2" BorderBrush="#DDD" BorderThickness="1" Padding="12">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel>
                  <Button x:Name="ResetToInheritedButton" DockPanel.Dock="Right" Content="Reset to inherited" Padding="8,3" Margin="0,0,6,0"
                          Click="ResetToInherited_Click" Visibility="Collapsed" ToolTip="Clear app-specific gesture settings and inherit global settings"/>
                  <Button x:Name="RemoveApplicationButton" DockPanel.Dock="Right" Content="Remove app" Padding="8,3"
                          Click="RemoveApplication_Click" Visibility="Collapsed" AutomationProperties.Name="Remove this application profile"/>
                  <TextBlock x:Name="SelectedProfileTitle" Text="Global defaults" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel Grid.Row="1" Margin="0,8,0,8">
                  <CheckBox x:Name="ApplicationEnabledCheckBox" Content="Enable gestures for this app"
                            VerticalAlignment="Center" Checked="ApplicationEnabled_Changed" Unchecked="ApplicationEnabled_Changed"
                            Visibility="Collapsed" AutomationProperties.Name="Enable gestures for this application"/>
                  <TextBlock x:Name="ProfileDescription" Text="These defaults apply to applications without an override."
                             Foreground="#666" TextWrapping="Wrap"/>
                </DockPanel>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel x:Name="GestureRowsPanel"/>
                </ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="AddCustomGestureButton" Content="Add custom shape…"
                          HorizontalAlignment="Left" Padding="10,5" Margin="0,0,8,0" Click="AddCustomGesture_Click"/>
                  <Button x:Name="AddStarterGesturesButton" Content="Add starter shapes…"
                          HorizontalAlignment="Left" Padding="10,5" Margin="0,0,8,0" Click="AddStarterGestures_Click"/>
                  <Button Content="Try a gesture safely…" HorizontalAlignment="Left" Padding="10,5" Click="PracticeGesture_Click"/>
                </StackPanel>
                <TextBlock Grid.Row="4" Text="Custom shapes are matched before directional gestures. Similar active shapes in one profile are rejected."
                           Foreground="#777" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Appearance" AutomationProperties.Name="Appearance settings">
        <StackPanel Margin="16">
          <GroupBox Header="Gesture feedback" Padding="12">
            <StackPanel>
              <CheckBox x:Name="TrailCheckBox" Content="Show cursor trail and direction feedback" Margin="0,0,0,8"
                        AutomationProperties.Name="Show cursor trail and direction feedback" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <TextBlock Text="The trail is drawn above the desktop while a middle-button gesture is in progress. This does not change gesture recognition."
                         Foreground="#666" TextWrapping="Wrap" Margin="22,0,0,0"/>
              <CheckBox x:Name="ResultFeedbackCheckBox" Content="Show a brief result message after a gesture" Margin="22,10,0,0"
                        AutomationProperties.Name="Show gesture result messages" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
              <TextBlock Text="Messages report the action taken or why a dragged gesture did not run." Foreground="#666" TextWrapping="Wrap" Margin="44,2,0,0"/>
              <CheckBox x:Name="ReducedEffectsCheckBox" Content="Reduce visual effects" Margin="22,10,0,0"
                        AutomationProperties.Name="Reduce visual effects" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
      <TabItem Header="Diagnostics" AutomationProperties.Name="Diagnostics">
        <StackPanel Margin="16">
          <GroupBox Header="Diagnostic logs" Padding="12">
            <StackPanel>
              <TextBlock Text="MidFlow writes diagnostic logs locally to help investigate input or action failures." TextWrapping="Wrap" Margin="0,0,0,10"/>
              <Button Content="Open log folder" HorizontalAlignment="Left" Padding="10,5" Click="OpenLogFolder_Click" AutomationProperties.Name="Open MidFlow diagnostic log folder"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Profile backup and transfer" Padding="12" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Text="Export all settings or selected application profiles. Imports are validated and previewed before they change this draft. A recovery backup is created before an import or restore."
                         TextWrapping="Wrap" Margin="0,0,0,10"/>
              <WrapPanel>
                <Button Content="Export all settings…" Padding="10,5" Margin="0,0,8,8" Click="ExportAll_Click"/>
                <Button Content="Export app profiles…" Padding="10,5" Margin="0,0,8,8" Click="ExportProfiles_Click"/>
                <Button Content="Import settings…" Padding="10,5" Margin="0,0,8,8" Click="ImportSettings_Click"/>
                <Button Content="Restore backup…" Padding="10,5" Margin="0,0,8,8" Click="RestoreBackup_Click"/>
              </WrapPanel>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </TabItem>
    </TabControl>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="Cancel" Width="86" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True"/>
      <Button x:Name="SaveButton" Content="Save" Width="86" IsDefault="True" Click="Save_Click" IsEnabled="False"/>
    </StackPanel>
  </Grid>
</Window>
